   "source": [
    "from tensorboardX import SummaryWriter\n",
    "\n",
    "writer = SummaryWriter(\"./log\")\n",
    "for i in range(100):\n",
    "    writer.add_scalar(\"a\", i, global_step=i)\n",
    "    writer.add_scalar(\"b\", i ** 2, global_step=i)\n",
    "writer.close()"
   ]
