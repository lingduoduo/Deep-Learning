{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // .tool_response.filePath'); echo \"$f\" | grep -q '\\.py$' && black \"$f\" 2>/dev/null || true",
            "statusMessage": "Formatting with black..."
          }
        ]
      }
    ]
  }
}
